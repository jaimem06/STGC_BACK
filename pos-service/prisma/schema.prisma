generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoTurno {
  ABIERTO
  CERRADO
  DESCUADRADO
}

enum EstadoPedido {
  EN_EDICION
  PENDIENTE_PAGO
  PAGADO
  ANULADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
}

model Turno {
  id              String       @id @default(uuid())
  usuarioId       String       // ID del cajero desde auth-service
  fechaApertura   DateTime     @default(now())
  fechaCierre     DateTime?
  montoApertura   Float
  montoCierreFisico Float?      // Lo que el cajero cuenta
  montoCierreSistema Float?     // Lo que el sistema calcula
  diferencia      Float?
  estado          EstadoTurno  @default(ABIERTO)
  pedidos         Pedido[]
  
  @@index([usuarioId])
}

model Pedido {
  id              String       @id @default(uuid())
  turnoId         String
  turno           Turno        @relation(fields: [turnoId], references: [id])
  cajero_id       String
  cliente         String?      // Legacy field, keep for compatibility or migrate? instructions say add new ones
  cliente_nombre  String?
  cliente_cedula  String?
  items           PedidoItem[]
  subtotal        Float
  iva             Float
  total           Float
  estado          EstadoPedido @default(EN_EDICION)
  metodoPago      MetodoPago?
  fecha_pago      DateTime?
  fechaCreacion   DateTime     @default(now())
  fechaActualizacion DateTime  @updatedAt

  @@index([turnoId])
}

model PedidoItem {
  id              String   @id @default(uuid())
  pedidoId        String
  pedido          Pedido   @relation(fields: [pedidoId], references: [id])
  productoId      String   // ID del producto desde el inventario
  nombre          String
  cantidad        Int
  precioUnitario  Float
  subtotal        Float

  @@index([pedidoId])
}

model ActiveSession {
  id            String   @id @default(uuid())
  usuarioId     String
  sessionToken  String   @unique
  fechaCreacion DateTime @default(now())

  @@index([usuarioId])
}
