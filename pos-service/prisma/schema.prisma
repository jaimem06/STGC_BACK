generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["pos_service"]
}

enum EstadoTurno {
  ABIERTO
  CERRADO
  DESCUADRADO
  @@schema("pos_service")
}

enum EstadoPedido {
  EN_EDICION
  PENDIENTE_PAGO
  PAGADO
  ANULADO
  @@schema("pos_service")
}

enum MetodoPago {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
  @@schema("pos_service")
}

model Turno {
  id              String       @id @default(uuid())
  usuarioId       String       
  fechaApertura   DateTime     @default(now())
  fechaCierre     DateTime?
  montoApertura   Float
  montoCierreFisico Float?      
  montoCierreSistema Float?     
  diferencia      Float?
  estado          EstadoTurno  @default(ABIERTO)
  pedidos         Pedido[]
  
  @@index([usuarioId])
  @@schema("pos_service")
}

model Pedido {
  id              String       @id @default(uuid())
  turnoId         String
  turno           Turno        @relation(fields: [turnoId], references: [id])
  cajero_id       String
  cliente_nombre  String?
  cliente_cedula  String?
  items           PedidoItem[]
  subtotal        Float
  iva             Float
  total           Float
  estado          EstadoPedido @default(EN_EDICION)
  metodoPago      MetodoPago?
  fecha_pago      DateTime?
  fechaCreacion   DateTime     @default(now())
  fechaActualizacion DateTime  @updatedAt

  @@index([turnoId])
  @@schema("pos_service")
}

model PedidoItem {
  id              String   @id @default(uuid())
  pedidoId        String
  pedido          Pedido   @relation(fields: [pedidoId], references: [id])
  productoId      String   
  nombre          String
  cantidad        Int
  precioUnitario  Float
  subtotal        Float

  @@index([pedidoId])
  @@schema("pos_service")
}

model ActiveSession {
  id            String   @id @default(uuid())
  usuarioId     String
  sessionToken  String   @unique
  fechaCreacion DateTime @default(now())

  @@index([usuarioId])
  @@schema("pos_service")
}
