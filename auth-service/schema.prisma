generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE_GENERAL
  GERENTE_OPERACIONES
  CAPATAZ
  SEMBRADOR
  RECOLECTOR
  CLASIFICADOR
  TECNICO_DESPULPADO
  ENCARGADO_SECADO
  TOSTADOR
  GESTOR_CALIDAD
  TECNICO_ALMACENAMIENTO
  CONTROLADOR_DESPACHO
  GESTOR_INVENTARIO
  PERSONAL_COCINA
  CAJERO_MESERO
  PRODUCTOR
  CATADOR
  BARISTA
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password_hash String
  role          Role       @default(CAJERO_MESERO)
  is_active     Boolean    @default(true)
  session_token String?    @unique
  audit_logs    AuditLog[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  action     String
  endpoint   String?
  ip_address String?
  created_at DateTime @default(now())

  @@map("audit_logs")
}
