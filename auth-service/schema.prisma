generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = "5"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Modelos del servicio de autenticación.
// Este servicio es independiente del dominio: solo gestiona identidad,
// sesiones, roles y auditoría. Las tablas de negocio pertenecen a otros servicios.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  users       User[]

  @@map("roles")
}

model User {
  id                    String        @id @default(uuid())
  email                 String        @unique
  first_name            String?
  last_name             String?
  identifier            String?       @unique
  phone_number          String?       @unique
  password_hash         String
  role_id               String
  status                UserStatus    @default(ACTIVO)
  email_verified        Boolean       @default(false)
  suspended_from        DateTime?
  suspended_until       DateTime?
  // Protección contra fuerza bruta
  failed_login_attempts Int           @default(0)
  locked_until          DateTime?
  last_login_at         DateTime?
  password_changed_at   DateTime      @default(now())
  // Autenticación en dos pasos (TOTP). El secreto se guarda cifrado.
  mfa_enabled           Boolean       @default(false)
  mfa_secret            String?
  mfa_last_used_step    Int?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @default(now()) @updatedAt
  role                  Role          @relation(fields: [role_id], references: [id])
  sessions              UserSession[]
  auth_tokens           AuthToken[]
  audit_logs            AuditLog[]

  @@index([role_id])
  @@map("users")
}

// Una sesión por dispositivo/login. El refresh token solo se guarda como hash SHA-256.
model UserSession {
  id                 String                @id @default(uuid())
  user_id            String
  refresh_token_hash String                @unique
  user_agent         String?
  ip_address         String?
  created_at         DateTime              @default(now())
  last_used_at       DateTime              @default(now())
  expires_at         DateTime
  revoked_at         DateTime?
  user               User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rotated_tokens     RotatedRefreshToken[]

  @@index([user_id])
  @@map("user_sessions")
}

// Hashes de todos los refresh tokens ya rotados de cada sesión. Si cualquiera se vuelve
// a presentar, alguien copió un token antiguo y la sesión completa se revoca.
model RotatedRefreshToken {
  token_hash String      @id
  session_id String
  rotated_at DateTime    @default(now())
  session    UserSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("rotated_refresh_tokens")
}

// Tokens de un solo uso (recuperación de contraseña, invitación, verificación de email).
model AuthToken {
  id         String       @id @default(uuid())
  user_id    String
  token_hash String       @unique
  purpose    TokenPurpose
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime     @default(now())
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@map("auth_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  // Null en eventos sin usuario identificado (p. ej. login fallido con email inexistente)
  user_id    String?
  action     String
  endpoint   String?
  ip_address String?
  user_agent String?
  details    String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

enum UserStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
  PENDIENTE
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}
