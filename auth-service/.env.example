# URL de conexión a la base de datos (PostgreSQL/Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/auth_db"

# Clave secreta para firmar los tokens JWT (Generar una segura)
SECRET_KEY="clave_secreta_super_segura_aqui"

# Algoritmo de encriptación para JWT
ALGORITHM="HS256"

# Tiempo de expiración de los tokens de acceso (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configuración de la API
APP_NAME="STGC Auth Service"
APP_VERSION="1.0.0"
API_PREFIX="/api"

# Entorno (development, production)
ENVIRONMENT="development"
