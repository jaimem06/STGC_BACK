# Auth Service: copia a .env. Detalle en README > "Variables de entorno". Por defecto: app/config.py.
# [OBLIGATORIA] no arranca sin ella · [PRODUCCIÓN] no arranca con un valor débil salvo ENVIRONMENT=development
# Claves: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Aplicación ---
APP_NAME=auth-service                   # Identificador técnico, visible en GET /
APP_DISPLAY_NAME="Mi Proyecto"          # Nombre en /docs, correos y app de autenticación (MFA)
API_PREFIX=/api                         # Prefijo de rutas: /api/auth/login
ENVIRONMENT=development                 # development/dev/local: solo avisos. Otro valor: estricto. production: +HSTS
DEBUG=False                             # Log DEBUG. Fuera de desarrollo bloquea el arranque
DOCS_ENABLED=True                       # False oculta /docs y /openapi.json

# --- Base de datos ---
DATABASE_URL="postgresql://usuario:password@host:5432/auth_db?sslmode=require"  # [OBLIGATORIA] URL de Neon tal cual; usada también por Alembic

# --- JWT ---
SECRET_KEY=                             # [PRODUCCIÓN] Firma HS*. Cambiarla invalida los access tokens (y el MFA sin DATA_ENCRYPTION_KEY)
JWT_ALGORITHM=HS256                     # HS256/384/512 con SECRET_KEY; RS256/384/512 con claves RSA y JWKS público
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"   # Solo RS*, RSA >= 2048 bits
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"      # Solo RS*, par de la privada
JWT_ISSUER=auth-service                 # Claim iss; los consumidores deben validarlo
JWT_AUDIENCE=mi-proyecto                # Claim aud; uno distinto por proyecto (p. ej. certiface)
ACCESS_TOKEN_EXPIRE_MINUTES=15          # Vida del access token (min). Más de 60 genera aviso
REFRESH_TOKEN_EXPIRE_DAYS=7             # Vida de la sesión sin renovarse (días)
MFA_TOKEN_EXPIRE_MINUTES=5              # Minutos para escribir el código TOTP tras el login

# --- Sesiones y tokens por correo ---
SINGLE_SESSION=False                    # True: cada login cierra las demás sesiones
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15  # Validez del enlace de recuperación (min)
INVITATION_TOKEN_EXPIRE_HOURS=72        # Validez de la invitación de /auth/register sin contraseña (h)
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24  # Validez del enlace de confirmación de email (h)
EMAIL_RESEND_COOLDOWN_SECONDS=60        # Espera entre correos del mismo tipo al mismo usuario (s)

# --- Contraseñas y fuerza bruta ---
PASSWORD_MIN_LENGTH=8                   # Longitud mínima (máximo fijo: 72 bytes de bcrypt)
PASSWORD_REQUIRE_COMPLEXITY=True        # Exige al menos una letra y un número
MAX_FAILED_LOGIN_ATTEMPTS=5             # Fallos (contraseña o MFA) antes de bloquear la cuenta
LOCKOUT_MINUTES=15                      # Duración del bloqueo; un gestor puede quitarlo con /unlock

# --- Registro ---
ALLOW_PUBLIC_REGISTRATION=False         # Habilita POST /auth/signup con DEFAULT_ROLE_NAME
REQUIRE_EMAIL_VERIFICATION=False        # Sin email confirmado no hay login (creados con contraseña y seed ya verificados)

# --- Claves internas y cifrado ---
INTERNAL_API_KEY=                       # [PRODUCCIÓN] Cabecera X-Internal-Api-Key de /internal/*. Distinta de SECRET_KEY, solo entre servidores
DATA_ENCRYPTION_KEY=                    # Fernet para secretos MFA (si falta, se deriva de SECRET_KEY). Genera: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Roles ---
ADMIN_ROLE_NAME=ADMIN                   # Acceso total; único que borra usuarios, ve auditoría y da roles privilegiados
DEFAULT_ROLE_NAME=USER                  # Rol por defecto y del auto-registro. Admin y este no se renombran ni eliminan
USER_MANAGER_ROLES=                     # Roles extra que gestionan usuarios/roles, sin tocar privilegiados. Vacío: solo admin

# --- Seed (solo python seed.py) ---
SEED_ADMIN_EMAIL=admin@example.com      # Email del admin inicial
SEED_ADMIN_PASSWORD=                    # Obligatoria para el seed; debe cumplir la política
SEED_EXTRA_ROLES=                       # "NOMBRE:Descripción,OTRO"; actualiza la descripción si existe
SEED_RESET_ADMIN_PASSWORD=False         # True sobrescribe la contraseña del admin existente

# --- Red y límites ---
CORS_ORIGINS=http://localhost:3000      # Frontends separados por coma. Sin definir: "*" (evitar en producción)
TRUSTED_PROXY_COUNT=0                   # Proxies delante: Render/FastAPI Cloud/Nginx 1, Cloudflare+Render 2
RATE_LIMIT_STORAGE_URI=memory://        # Con varias instancias: redis://host:6379
RATE_LIMIT_DEFAULT=200/minute           # Límite por IP de rutas sin límite propio
MAX_REQUEST_BODY_BYTES=65536            # Tamaño máximo del cuerpo; mayores reciben 413

# --- Correo (SMTP): sin usuario y contraseña no se envían correos, solo se registra en el log ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                           # 465: SSL directo; otro puerto: STARTTLS si SMTP_TLS=True
SMTP_USER=correo@gmail.com
SMTP_PASSWORD="app password"            # En Gmail, contraseña de aplicación
SMTP_FROM_EMAIL=correo@gmail.com        # Remitente visible (por defecto SMTP_USER)
SMTP_TLS=True                           # STARTTLS en puertos distintos de 465

# --- Frontend ---
FRONTEND_URL=http://localhost:3000      # Base de los enlaces de los correos
FRONTEND_RESET_PASSWORD_PATH=/reset-password  # Recibe ?token= para nueva contraseña o invitación
FRONTEND_VERIFY_EMAIL_PATH=/verify-email      # Recibe ?token= para confirmar el email
