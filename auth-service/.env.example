# ============================================================
# Auth Service - variables de entorno
# Copia este archivo a .env y ajusta los valores para tu proyecto.
# Genera claves con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# --- Aplicación ---
APP_NAME=auth-service
APP_DISPLAY_NAME="Mi Proyecto"          # Nombre visible en correos y documentación
API_PREFIX=/api
ENVIRONMENT=development                 # Solo para local. Cualquier otro valor (o ninguno) es estricto
DEBUG=False
DOCS_ENABLED=True                       # False oculta /docs y /openapi.json

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:password@host:5432/auth_db?sslmode=require"

# --- JWT ---
SECRET_KEY=                             # Obligatoria fuera de desarrollo (ver comando arriba)
JWT_ALGORITHM=HS256                     # HS256 (secreto compartido) o RS256 (clave pública vía JWKS)
# Solo para RS256 (PEM; se admite una sola línea con \n):
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=auth-service
JWT_AUDIENCE=mi-proyecto                # Los servicios consumidores deben validar este valor
ACCESS_TOKEN_EXPIRE_MINUTES=15          # Máximo recomendado: 60
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_TOKEN_EXPIRE_MINUTES=5

# --- Sesiones ---
SINGLE_SESSION=False                    # True: cada login cierra las demás sesiones del usuario

# --- Tokens por correo ---
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
INVITATION_TOKEN_EXPIRE_HOURS=72
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60

# --- Política de contraseñas ---
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=True        # Exige al menos una letra y un número

# --- Fuerza bruta ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Registro ---
ALLOW_PUBLIC_REGISTRATION=False         # Habilita POST /auth/signup
REQUIRE_EMAIL_VERIFICATION=False        # Exige confirmar el email antes de iniciar sesión

# --- Claves internas y cifrado ---
INTERNAL_API_KEY=                       # Otra clave aleatoria, distinta de SECRET_KEY
# Clave Fernet para cifrar secretos MFA. Genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# --- Roles ---
ADMIN_ROLE_NAME=ADMIN                   # Rol con acceso total
DEFAULT_ROLE_NAME=USER                  # Rol asignado cuando no se indica uno
USER_MANAGER_ROLES=                     # Roles extra que gestionan usuarios/roles, p. ej. "MANAGER,SUPERVISOR"

# --- Seed inicial (python seed.py) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=                    # Obligatoria; debe cumplir la política de contraseñas
SEED_EXTRA_ROLES=                       # p. ej. "MANAGER:Gestor del sistema,EDITOR"
SEED_RESET_ADMIN_PASSWORD=False         # True sobrescribe la contraseña si el admin ya existe

# --- Red ---
CORS_ORIGINS=http://localhost:3000      # Lista separada por comas. Evita "*" en producción
TRUSTED_PROXY_COUNT=0                   # Render/Heroku/Nginx delante: 1. Cloudflare + Render: 2
RATE_LIMIT_STORAGE_URI=memory://        # Con varias instancias: redis://host:6379
RATE_LIMIT_DEFAULT=200/minute
MAX_REQUEST_BODY_BYTES=65536            # Cuerpos mayores reciben 413

# --- Correo (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@gmail.com
SMTP_PASSWORD="app password"
SMTP_FROM_EMAIL=correo@gmail.com
SMTP_TLS=True

# --- Frontend que consume este servicio ---
FRONTEND_URL=http://localhost:3000
FRONTEND_RESET_PASSWORD_PATH=/reset-password
FRONTEND_VERIFY_EMAIL_PATH=/verify-email
