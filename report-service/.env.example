DATABASE_URL=postgresql://usuario:password@host/basedatos?sslmode=require
# JWT (debe coincidir con auth-service)
JWT_SECRET=cambia-esto
# Orígenes permitidos por CORS (separados por coma). Usa "*" para permitir todos.
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001,https://stgc-web.onrender.com
# Puerto de escucha (Render lo inyecta automáticamente)
PORT=3002
# Opcional: tabla de usuarios del auth-service, si no se autodetecta.
# Por defecto se localiza sola (public.users u otro esquema de la misma base).
# AUTH_USERS_TABLE=auth_service.users
